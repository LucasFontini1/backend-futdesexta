# Fut de Sexta. Copie como .env e nunca versione credenciais reais.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///db.sqlite3
# Em produção: postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require
# Utilizar a string de conexão PostgreSQL do projeto Supabase.
CLOUDINARY_URL=
SECURE_SSL_REDIRECT=true
