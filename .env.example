# Fut de Sexta. Copie como .env e nunca versione credenciais reais.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URLS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///db.sqlite3
# Em produção: postgresql://USUARIO:SENHA@HOST:5432/postgres?sslmode=require
# Utilizar a string de conexão PostgreSQL do projeto Supabase.
CLOUDINARY_URL=
SECURE_SSL_REDIRECT=false

# SMTP obrigatório em produção para verificação de e-mail e recuperação de senha.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Push no servidor. Nunca publique a chave privada.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Atualize o domínio real antes da implantação. Em produção, DEBUG=false.
